# Copia este archivo como .env.local y completa los valores de tu proyecto Supabase
# (Supabase → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secreta: solo se usa en el servidor. Nunca la subas a git ni la compartas.
SUPABASE_SERVICE_ROLE_KEY=

# Correos con permisos de moderación, separados por coma
ADMIN_EMAILS=tu.correo@pucp.edu.pe
